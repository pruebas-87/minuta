# Servidor local de Ollama
OLLAMA_URL=http://127.0.0.1:11434

# Modelo instalado localmente
OLLAMA_MODEL=qwen3.8:27b

# Contexto por llamada. Bajarlo a 4096 si el driver CUDA falla al cargar el modelo.
# La app reintenta sola con la mitad de contexto al detectar ese error.
OLLAMA_NUM_CTX=8192

# Opcional: ruta explícita a Chrome/Edge si la autodetección falla
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
